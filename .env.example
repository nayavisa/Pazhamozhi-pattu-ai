# Pazhamozhi Pattu AI — environment variables
#
# None are required to run the API today. The placeholders below are reserved
# for the upcoming Render deploy (Task 2) and will be wired into api.py at
# that point.
#
# To use locally: cp .env.example .env  (and fill in values; .env is gitignored)

# Comma-separated list of allowed origins for CORS.
# Leave unset or `*` for development; tighten to your real domains in prod.
# Example: ALLOWED_ORIGINS=https://pazhamozhipattu.com,https://www.pazhamozhipattu.com
# ALLOWED_ORIGINS=*

# HTTP port the server binds to. Render injects this automatically; set
# locally only if 8000 conflicts with something else on your machine.
# PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
